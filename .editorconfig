root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 150

[*.java]
indent_style = space
indent_size = 4
tab_width = 4

# IntelliJ (opcional, mas util para aproximar do Checkstyle)
ij_continuation_indent_size = 4
# tag::intellij-java-specific[]
ij_java_keep_line_breaks = true
ij_java_use_single_class_imports = true
ij_java_class_count_to_use_import_on_demand = 999
ij_java_names_count_to_use_import_on_demand = 999
ij_java_imports_layout = $*, |, *, |, br.com.**

[*.{kt,kts,groovy,gradle}]
indent_style = space
indent_size = 4
tab_width = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2
tab_width = 2

[*.md]
trim_trailing_whitespace = false
